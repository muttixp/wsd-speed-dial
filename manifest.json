{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "WSD",
  "version": "1.1.0",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "author": "muttixp",
  "icons": {
    "16": "icons/wsd16.png",
    "32": "icons/wsd32.png",
    "48": "icons/wsd48.png",
    "128": "icons/wsd128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/wsd16.png",
      "24": "icons/wsd24.png",
      "32": "icons/wsd32.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "js/arkaplan.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "tabs",
    "contextMenus",
    "alarms",
    "scripting",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "key": ""
}